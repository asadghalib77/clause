# APP
RAG_APP_NAME=Clause
RAG_DATA_PATH=data/shop_handbook.pdf

# CHAT
RAG_CHAT_MODEL=gemma4:31b-cloud
RAG_CHAT_TEMPERATURE=0.1

# EMBEDDINGS
RAG_EMBED_PROVIDER=ollama
RAG_EMBED_MODEL=nomic-embed-text:latest
RAG_EMBED_DIM=768

# INDEXING
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

# QDRANT
RAG_COLLECTION=shop_handbook
RAG_QDRANT_DATA=./qdrant_data

# PROMPTS
RAG_SYSTEM="You are a helpful Clause shop assistant. Answer only from the context provided."