# APP
RAG_APP_NAME=Clause
RAG_DATA_PATH=files/shop_handbook.pdf

# CHAT
RAG_CHAT_PROVIDER = ollama
RAG_CHAT_MODEL=gemma3:1b
RAG_CHAT_TEMPERATURE=0.1

# EMBEDDINGS
RAG_EMBED_PROVIDER=ollama
RAG_EMBED_MODEL=nomic-embed-text:latest
RAG_EMBED_DIM=768

# INDEXING
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

#RETRIEVAL
RAG_TOP_K = 3
RAG_SCORE_THRESHOLD=0.5

# QDRANT
RAG_COLLECTION=shop_handbook
RAG_QDRANT_DATA=./vector_stores

# PROMPTS
RAG_SYSTEM="You are a helpful Clause shop assistant. Answer only from the context provided."

# Optional: Use only if connecting to remote Qdrant
# RAG_QDRANT_URL = http:/localhost:6333